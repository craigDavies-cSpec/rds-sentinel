#!/bin/sh
# Git pre-commit hook to prevent committing credentials (AWS keys) or .env files

echo "Running Security Pre-commit Hooks..."

# 1. Block committed .env files
if git diff --cached --name-only | grep -E '^(\.env|\.env\.local)$'; then
    echo "❌ SECURITY ERROR: You are attempting to commit environment files (.env / .env.local)!"
    echo "Please remove them from index using: git rm --cached <file>"
    exit 1
fi

# 2. Block plaintext AWS keys in code files
# Scans staged changes for the standard AKIA pattern
AWS_KEY_PATTERN="AKIA[A-Z0-9]{16}"
STAGED_FILES=$(git diff --cached --name-only)

for file in $STAGED_FILES; do
    if git diff --cached "$file" | grep -E "^[+][^*]*$AWS_KEY_PATTERN" > /dev/null; then
        echo "❌ SECURITY ERROR: Plaintext AWS Access Key detected in staged modifications for file: $file"
        echo "Please remove the credentials and use AWS Secrets Manager or environment variables!"
        exit 1
    fi
done

echo "✅ Security checks passed."
exit 0
