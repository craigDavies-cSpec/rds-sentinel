# AWS RDS Free Tier Sandbox Credentials Example Template
# Copy to .env and fill with your environment values

RDS_DB_NAME=sentineldb
RDS_DB_IDENTIFIER=free-tier-sandbox-db
RDS_DB_USER=postgres
RDS_DB_PASSWORD=YOUR_MASTER_PASSWORD
RDS_DB_PORT=5432
RDS_DB_HOST=YOUR_RDS_ENDPOINT_HOST

AWS_REGION=us-east-1
AWS_ACCOUNT_ID=YOUR_AWS_ACCOUNT_ID
AWS_MONITORING_ROLE_ARN=arn:aws:iam::YOUR_ACCOUNT_ID:role/RDSSentinelCrossAccountMonitoringRole
AWS_EXTERNAL_ID=YOUR_SECURE_EXTERNAL_ID

INGESTION_FUNCTION_URL=http://127.0.0.1:4566/
