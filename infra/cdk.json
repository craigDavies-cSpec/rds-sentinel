{
  "app": "node bin/rds-sentinel-infra.js",
  "watch": {
    "include": [
      "**"
    ],
    "exclude": [
      "README.md",
      "cdk.*.json",
      "tsconfig.json",
      "package*.json",
      "node_modules"
    ]
  },
  "context": {
    "@aws-cdk/core:bootstrapQualifier": "rds-sentinel",
    "@aws-cdk/core:newStyleStackSynthesis": true
  }
}
